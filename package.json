{
  "name": "@slashand/sdui-blade-angular",
  "version": "1.0.0",
  "description": "Angular v21 SDUI rendering wrapper for the Agnostic Blade System.",
  "author": "Slashand Studio",
  "license": "MIT",
  "keywords": [
    "sdui",
    "server-driven-ui",
    "angular",
    "blade-system",
    "json-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/slashand/sdui-blade-angular.git"
  },
  "bugs": {
    "url": "https://github.com/slashand/sdui-blade-angular/issues"
  },
  "homepage": "https://github.com/slashand/sdui-blade-angular#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "exports": {
    "./src/lib/sdui-blade-theme.css": {
      "style": "./src/lib/sdui-blade-theme.css",
      "default": "./src/lib/sdui-blade-theme.css"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "test": "vitest run",
    "publish:latest": "npm run build && npm publish ./dist --access public --tag latest --provenance",
    "publish:prod": "npm run publish:latest"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@ngneat/elf": "latest",
    "@slashand/sdui-blade-core": "^1.0.0-alpha.4"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "jsdom": "^29.1.1",
    "ng-packagr": "^21.2.7",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "zone.js": "^0.16.3",
    "@angular/build": "^21.2.30"
  }
}
